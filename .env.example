# ============================================================================
# das-hogikids — MẪU biến môi trường. Copy sang `.env` rồi điền giá trị thật.
# `.env` đã bị .gitignore chặn → KHÔNG BAO GIỜ commit `.env` có giá trị thật.
# ============================================================================

# ---- APP RUNTIME (container hogikids-app nạp qua env_file) ------------------
# Nối Postgres qua TÊN container supabase-db (app cùng mạng docker supabase_default).
# Sau consolidation 2026-07-16: app dùng DB `postgres` SCHEMA `app` (role `hogikids` giữ nguyên);
# nối DIRECT 5432, KHÔNG qua supavisor pooler 6543/5433 (raw SQL dựa session search_path).
DATABASE_URL="postgresql://hogikids:PASSWORD@supabase-db:5432/postgres?schema=app"
# ---- TEST (vitest/playwright — dev Mac trỏ qua Tailscale) ----
# CẢNH BÁO: dev nối chung DB prod qua Tailscale (chỉ 1 DB thật) — TEST_DATABASE_URL PHẢI trỏ
# database RIÊNG `hogikids_test` (cùng ?schema=app), nếu không test sẽ reset/seed nhầm dữ liệu thật.
TEST_DATABASE_URL="postgresql://hogikids:PASSWORD@db-host:5432/hogikids_test?schema=app"
# E2E (Playwright) dùng DATABASE RIÊNG để không giẫm dữ liệu với vitest (hai bộ cùng deleteMany()
# không phạm vi trên Expense). Bỏ trống ⇒ e2e rơi về TEST_DATABASE_URL như cũ.
# Tên database vẫn PHẢI kết thúc "_test" (guard từ chối chạy nếu không). DB mới phải chạy
# `prisma migrate deploy` + `prisma db seed` một lần (ref-data Channel/Category cho FK).
TEST_DATABASE_URL_E2E="postgresql://hogikids:PASSWORD@db-host:5432/hogikids_e2e_test?schema=app"
SESSION_SECRET=""                 # openssl rand -base64 32
INGEST_SECRET=""                  # openssl rand -base64 32 — bearer cho /api/ingest/* + host cron backup
# TUỲ CHỌN (override): nút "Đồng bộ ngay" ưu tiên env này khi ĐẶT; ĐỂ NGUYÊN COMMENT thì app tự
# ghép từ `Setting.n8nBaseUrl` (khối "Kết nối n8n" ở /cai-dat) + path đọc từ workflow trong repo.
# Đặt giá trị ở đây là đường Setting KHÔNG BAO GIỜ chạy — chỉ dùng khi cố ý ép đích khác.
# N8N_SYNC_WEBHOOK_URL="http://hogikids-n8n:5678/webhook/hogikids-sync-now"
# URL NỘI BỘ của app mà n8n gọi tới (n8nAppUrl). BẮT BUỘC cho nút "Cài / cập nhật workflows"
# (app tự ghi vào kho khoá — cố ý KHÔNG có default: default sai là đồng bộ đứng im âm thầm).
APP_INTERNAL_URL="http://hogikids-app:3000"
NEXT_PUBLIC_APP_URL="https://app.example.com"
# BRONZE_ONLY="true" ⇒ ingest CHỈ land Bronze, KHÔNG dựng Silver (dùng khi định nghĩa Silver chưa chốt:
# raw vẫn kéo về đều, bảng nghiệp vụ đứng yên). Bỏ trống / giá trị khác "true"|"1" ⇒ land + transform.
# Chỉ áp cho /api/ingest/raw (Pancake) — /api/ingest/ads vẫn ghi thẳng Expense.
# ⚠️ TẮT công tắc thì PHẢI chạy ngay: npx tsx scripts/rebuild-from-raw.ts
#    (đơn đã land sẽ trùng hash → không land lại → transform theo trang dựng 0 dòng → mất doanh thu âm thầm)
BRONZE_ONLY=""
# ⚠️ INIT_EMAIL/INIT_PASSWORD CHỈ dùng cho LẦN SEED ĐẦU TIÊN (docker compose run --rm app npx prisma db seed
# — xem hướng dẫn deploy). docker-compose.yml nạp `env_file: .env` vào container ở
# MỌI lần chạy, không riêng lúc seed ⇒ nếu để nguyên, mật khẩu PLAINTEXT sẽ tồn tại lâu dài trong runtime env
# của container app-đang-chạy. SAU KHI seed xong PHẢI xoá 2 dòng này khỏi `.env` THẬT. Cần seed lại (vd tạo
# lại user sau khi lỡ xoá) thì tạm điền lại giá trị, seed xong lại xoá ngay — không để tồn tại thường trực.
INIT_EMAIL=""                     # email đăng nhập app (seed 1 user)
INIT_PASSWORD=""                  # mật khẩu đăng nhập app (seed)

# ---- n8n CREDENTIALS (cấu hình vào n8n UI — app KHÔNG nạp; lưu ở đây để tham chiếu) ----
# Pancake POS — Task 1 phase 2: shop dùng 3 key (kho chính + Shopee-sync + TikTok-sync).
# scripts/explore-pancake-api.ts đọc các key dưới + tự khám phá shop qua GET /shops.
PANCAKE_API_KEY_KHO=""                 # KHO CHÍNH (master) — bắt buộc
PANCAKE_SHOP_ID_KHO=""                 # optional — script tự khám phá qua GET /shops
PANCAKE_API_KEY_SHOPEE=""          # key kéo đơn Shopee (nếu là shop Pancake riêng)
PANCAKE_SHOP_ID_SHOPEE=""
PANCAKE_API_KEY_TIKTOK=""          # key kéo đơn TikTok
PANCAKE_API_ID_TIKTOK=""
META_ADS_ACCESS_TOKEN=""
META_ADS_ACCOUNT_ID=""            # act_...
TIKTOK_BUSINESS_ACCESS_TOKEN=""
TIKTOK_ADVERTISER_ID=""

# TikTok Shop Open API — phí/settlement/hoa hồng AFF/GMV Max (nguồn đối chứng ĐỘC LẬP với Pancake).
# app_key/app_secret lấy ở Partner Center; access/refresh token đổi từ auth code (cấp quyền 1 lần).
# ⚠️ Refresh XOAY VÒNG token: chỉ được để DUY NHẤT 1 hệ refresh, 2 hệ cùng refresh sẽ giết token của nhau.
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
TIKTOK_SHOP_SERVICE_ID=""         # dựng link cấp quyền: services.tiktokshop.com/open/authorize?service_id=
TIKTOK_SHOP_ACCESS_TOKEN=""       # đổi từ auth code, hạn ~7 ngày → phải refresh định kỳ
TIKTOK_SHOP_REFRESH_TOKEN=""      # hạn rất dài; mất là phải cấp quyền lại bằng tay
TIKTOK_SHOP_CIPHER=""             # bắt buộc kèm mọi request Finance/Order
TIKTOK_SHOP_ID=""
# Phase 7 (marketing) — có thể để trống tới phase 7
# (TIKTOK_SHOP_ACCESS_TOKEN/CIPHER dùng chung khối TikTok Shop Open API bên trên — đừng khai báo lại, dotenv lấy giá trị khai sau đè giá trị trước)
META_PAGE_ACCESS_TOKEN=""
META_PAGE_ID=""

# ---- n8n MCP + REST API (deploy/test workflow qua Claude — KHÔNG nạp app runtime) ----
N8N_API_URL="https://n8n.example.com"
N8N_MCP_URL="https://n8n.example.com/mcp-server/http"
N8N_MCP_ACCESS_TOKEN=""            # JWT aud=mcp-server-api (n8n: MCP access) — cho HTTP MCP build workflow
N8N_API_KEY=""                     # JWT aud=public-api (n8n: Settings → n8n API) — REST execute/activate/list

# ---- INFRA / OPERATOR (đăng nhập quản trị) ---------------------------------
MINIPC_SSH="user@ssh-host"                # SSH tới host deploy (tuỳ hạ tầng)
SUPABASE_DB_SUPERUSER_PW=""               # superuser THẬT = supabase_admin (role `postgres` ở đây KHÔNG superuser) — ops role/schema/ownership; lấy từ Supabase .env trên minipc
SUPABASE_STUDIO_LOGIN=""                  # user/pass supabase.<domain>
N8N_LOGIN=""                              # user/pass homen8n.<domain>
