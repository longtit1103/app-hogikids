/// Cửa vào không cần hiểu payload: loại sự kiện nào cũng nhận (`orders`, `products`,
/// `variations_warehouses`, và loại Pancake thêm sau) nên không bao giờ mất dữ liệu vì
/// app chưa biết shape. Nơi transform đọc để dựng Silver vẫn LÀ các bảng Bronze cũ —
/// bảng này KHÔNG được làm nguồn thứ 2 cho Silver/P&L.
///
/// `payload` là TEXT **nguyên xi** chứ không phải jsonb: giữ đúng từng byte Pancake gửi
/// (id int64 như `585140898791786238` an toàn tuyệt đối, không bị chuẩn hoá khoá/khoảng trắng).
/// Cần truy vấn thì cast tại chỗ: `payload::jsonb->>'type'`. Chiều TEXT → jsonb luôn dựng được,
/// chiều ngược lại thì không.
///
/// KHÔNG đặt job dọn theo hạn: kho mẫu webhook của hệ cũ đã mất sạch vì đúng một cron
/// xoá > 30 ngày. Khối lượng ~12 sự kiện/ngày (~44MB/năm) — giữ vĩnh viễn.
model RawPancakeWebhookEvent {
  id            String   @id @default(cuid())
  /// Shop Pancake suy từ endpoint nhận (`SHOP_KHO` | `SHOP_SHOPEE` | `SHOP_TIKTOK`).
  shopId        String
  payload       String
  /// md5(payload) — chỉ để nạp bù chạy lại không nhân bản dòng, KHÔNG phải để lọc dữ liệu.
  payloadHash   String
  receivedAt    DateTime @default(now())
  /// Đường vào: `webhook` (n8n bắn thẳng) | `file` (nạp bù từ file mẫu pha 1) | `db-cu`
  /// (nạp bù từ bảng `webhook_raw_events` của hệ trước 2026-06).
  source        String   @default("webhook")
  /// KẾT CỤC xử lý pha 2 (payload gốc không bao giờ sửa): `don-hang` | `don-hang-cu-hon` |
  /// `don-hang-can-xem` | `ton-kho-bo-qua` | `san-pham-bo-qua` | `bronze-only` |
  /// `khong-nhan-dien` | `loi`. Nguồn giá trị: `KetCucXuLy` ở `src/lib/ingest/webhook-processor.ts`.
  /// NULL = dòng trước pha 2 / nạp bù (không replay — snapshot cũ đè bản API mới là hỏng Silver).
  processedAs   String?
  /// Chi tiết cho ca cần người xem (sự kiện lạ, lỗi xử lý) — hiển thị ở /cai-dat để bắt lỗi vào fix.
  processedNote String?

  /// Khoá idempotent cho nạp bù: chạy lại script trên cùng file/bản ghi không đẻ dòng mới.
  /// Sự kiện LIVE luôn có `receivedAt` mới nên 2 lần Pancake bắn trùng vẫn giữ đủ cả hai.
  @@unique([shopId, receivedAt, payloadHash])
  @@index([shopId, receivedAt])
  @@index([receivedAt])
}

/// Bản sao lưu MỖI workflow n8n TRƯỚC khi lượt "Cài / cập nhật workflows" (provisioning từ
/// /cai-dat) PUT đè bản đang chạy — hiện vật khôi phục được (log server không phải hiện vật:
/// json-file rotate + xen log Next). Backup ghi KHÔNG thành công ⇒ provisioning BỎ QUA workflow
/// đó, tuyệt đối không PUT (cổng fail-closed). Retention: provisioning tự tỉa, giữ N lượt gần
/// nhất mỗi tên workflow.
model N8nWorkflowBackup {
  id        String   @id @default(uuid())
  /// Tên workflow trên n8n tại thời điểm backup (khớp field `name` trong JSON export).
  name      String
  /// Nguyên văn JSON bản đang chạy do n8n API trả về (GET /workflows/{id}) — PUT lại là khôi phục.
  payload   String
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

/// THÙNG RÁC KHÔI PHỤC — ảnh chụp (snapshot) của bản ghi TIỀN vừa bị xoá cứng, cho 5 bảng nhập tay:
/// `Expense` · `CashMovement` · `ThuNhap` · `Loan` · `SoTietKiem`. Chủ shop xoá nhầm một dòng chi phí
/// là mất hẳn (không có bản gốc Bronze nào dựng lại được), nên mọi lượt xoá phải chụp ảnh TRƯỚC, TRONG
/// CÙNG transaction với câu xoá.
///
/// VÌ SAO BẢNG RIÊNG chứ không thêm cột `deletedAt` vào 5 bảng kia: soft-delete bằng cột buộc phải sửa
/// hơn 20 query đọc tiền (pnl.ts · daily-series.ts · cash-flow.ts · so-quy-queries.ts · expense-queries.ts
/// · cash-movement-queries.ts · /kenh), trong đó 3 chỗ là raw SQL — quên một chỗ là dòng đã xoá vẫn cộng
/// vào Lãi/Lỗ mà không test nào đỏ. Nó còn phá `Expense.refId @unique` + `ThuNhap.refId @unique` (cổng
/// chống ghi trùng kỳ vay / lãi tiết kiệm) và phá các cổng chặn xoá Loan/SoTietKiem vốn ĐẾM DÒNG con.
/// Ở đây xoá vẫn là xoá CỨNG ⇒ 0 query hiện có phải đổi, và dòng trong thùng rác không có đường nào
/// lọt vào P&L / Sổ quỹ / sổ chi phí.
///
/// KHÔNG có FK tới bản ghi gốc (bản ghi đó đã biến mất) — `banGhiId` chỉ là id CŨ, dùng để khôi phục
/// lại ĐÚNG id đó. Nhập tay 100% ⇒ rebuild-from-raw KHÔNG đụng; "Xoá dữ liệu giao dịch" thì xoá luôn.
model BanGhiDaXoa {
  id String @id @default(cuid())

  /// Tên model Prisma của bản ghi gốc: Expense | CashMovement | ThuNhap | Loan | SoTietKiem.
  bang     String
  /// Id CŨ của bản ghi gốc — khôi phục dựng lại đúng id này (đường dẫn/ảnh chụp cũ còn trỏ tới nó).
  banGhiId String

  /// Câu tiếng Việt đọc được ngay trên màn thùng rác, vd "Nhập hàng — 28.999.920 ₫ — 04/09/2026".
  /// LƯU chứ không dựng lại lúc đọc: danh mục/khoản vay gốc có thể đã bị xoá sau đó.
  nhan   String
  /// Số tiền ĐỂ HIỂN THỊ (luôn dương). KHÔNG phải nguồn số cho bất kỳ phép tính tiền nào.
  soTien Int
  /// Ngày nghiệp vụ của bản ghi gốc (ngày chi / ngày dòng tiền / ngày bắt đầu) — để sắp xếp + lọc.
  ngay   DateTime

  /// Ảnh chụp ĐẦY ĐỦ: bản ghi cha + mọi bản ghi con bị xoá kèm (dòng tiền của khoản vay / sổ tiết
  /// kiệm) + ghi chú khôi phục. Shape ở `src/lib/thung-rac/chup-anh-ban-ghi.ts` — đọc nó trước khi
  /// đổi. `Json` chứ không TEXT: cần lọc/đọc bằng SQL khi đối chiếu sự cố.
  anh Json

  xoaLuc      DateTime  @default(now())
  /// NULL = còn trong thùng rác; có giá trị = đã khôi phục (mục đã khôi phục KHÔNG khôi phục lại).
  khoiPhucLuc DateTime?

  @@index([xoaLuc])
  @@index([bang, banGhiId])
}
