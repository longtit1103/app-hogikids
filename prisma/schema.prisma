// ===== Silver — Tiền đã về TikTok (đối soát settlement, Phase 2) =====
// Nguồn: Bronze RawTiktokShop{Statement,Transaction,Payment}. CHỈ dòng tiền ĐỐI CHIẾU
// (tiền TikTok đã thanh toán) — ĐỘC LẬP P&L/doanh thu (doanh thu CHỈ từ Pancake, bất biến #2).
// Money = Int VND (payload là STRING → đọc lossless). Ngày = instant từ epoch giây
// (`new Date(epoch*1000)`; container TZ=Asia/Ho_Chi_Minh nên biên tháng theo giờ VN).

model TiktokSettlement {
  id                 String    @id @default(cuid())
  statementId        String    @unique // = externalId statement (id sao kê)
  shopId             String
  statementTime      DateTime
  paymentTime        DateTime?
  paymentStatus      String
  paymentId          String? // link TiktokPayment (sao kê gộp vào lệnh rút nào)
  settlementAmount   Int // NET đã về (sau phí/hoàn/ads)
  revenueAmount      Int
  feeAmount          Int
  adjustmentAmount   Int
  netSalesAmount     Int
  shippingCostAmount Int
  currency           String    @default("VND")
  raw                Json?
  syncedAt           DateTime  @default(now())

  @@index([statementTime])
}

model TiktokAdsSettlement {
  id               String   @id @default(cuid())
  transactionId    String   @unique // = externalId txn (type=GMV_PAYMENT_FOR_TIKTOK_ADS)
  shopId           String
  adjustmentId     String?
  orderCreateTime  DateTime
  settlementAmount Int // ÂM — TikTok trừ ads vào số dư
  raw              Json?
  syncedAt         DateTime @default(now())

  @@index([orderCreateTime])
}

model TiktokPayment {
  id              String    @id @default(cuid())
  paymentId       String    @unique // = externalId payment
  shopId          String
  status          String // PAID | FAILED | ...
  paidTime        DateTime?
  settlementValue Int // tiền vào bank (settlement_amount.value)
  amountValue     Int
  reserveValue    Int       @default(0)
  bankAccount     String?
  raw             Json?
  syncedAt        DateTime  @default(now())

  @@index([paidTime])
}

// ===== Bronze + Silver — Tiền đã về Shopee (import file ví THỦ CÔNG, Phase 3) =====
// Shopee KHÔNG có API → chủ shop tải TAY file ví "Transaction Report" (my_balance_transaction)
// mỗi kỳ → upload UI → land Bronze RawShopeeWalletTxn → transform Silver ShopeeSettlement.
// CHỈ dòng tiền "đã về" (net + rút bank) — ĐỘC LẬP P&L/doanh thu (doanh thu CHỈ từ Pancake,
// bất biến #2). Phí sàn Shopee đã có ở P&L qua Pancake `fee_marketplace` — TUYỆT ĐỐI KHÔNG
// lấy số ví sửa P&L (đếm 2 lần). Money = Int VND; txnTime = instant giờ VN (có giây).

model RawShopeeWalletTxn {
  id          String   @id @default(cuid())
  shopId      String
  externalId  String
  payloadHash String
  payload     Json
  fetchedAt   DateTime @default(now())
  syncLogId   String?

  @@unique([shopId, externalId, payloadHash])
  @@index([shopId, externalId, fetchedAt])
  @@index([fetchedAt])
}

// Grain = 1 dòng ledger ví. `externalId` = khoá tổng hợp `txnTime|type|orderCode|amount` (bất biến
// qua re-export — KHÔNG dùng runningBalance vì số dư dịch khi có điều chỉnh back-date → đếm 2 lần).
// `amount` CÓ DẤU (ép theo cột "Dòng tiền": Tiền ra→âm, Tiền vào→dương). `runningBalance` lưu để
// hiển thị, KHÔNG vào khoá. net "đã về" = Σ amount type∈{REVENUE,ADJUSTMENT}; rút bank = |Σ| WITHDRAWAL.
model ShopeeSettlement {
  id             String   @id @default(cuid())
  externalId     String   @unique
  shopId         String
  txnTime        DateTime
  type           String // REVENUE | ADJUSTMENT | WITHDRAWAL | OTHER
  orderCode      String?
  amount         Int // CÓ DẤU (ép theo cột "Dòng tiền")
  status         String
  runningBalance Int // lưu display — KHÔNG vào khoá externalId
  raw            Json?
  syncedAt       DateTime @default(now())

  @@index([txnTime])
}

